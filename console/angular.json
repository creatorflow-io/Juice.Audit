{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "@juice-js/audit": {
      "projectType": "library",
      "root": "projects/juice-js/audit",
      "sourceRoot": "projects/juice-js/audit/src",
      "prefix": "ja",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/juice-js/audit/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/juice-js/audit/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/juice-js/audit/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
