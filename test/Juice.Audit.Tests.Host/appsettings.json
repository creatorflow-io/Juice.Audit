{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Messaging": {
    "PublishingPolicies": {
      "Rules": [
        {
          "//": "In-process mode: the outbox delivers the data changes to this app's own consumer.",
          "Priority": 100,
          "Match": { "Domain": "juice.audit" },
          "Publishers": [ { "Key": "local", "Destination": "juice.audit" } ]
        }
      ]
    }
  },
  "Audit": {
    "Mode": "InProcess",
    "Export": {
      "//": "The tests read the audit database right after a request: export inside the request (SC-007).",
      "Synchronous": true
    },
    "Filters": [
      {
        "Methods": [ "POST", "PUT", "DELETE" ]
      },
      {
        "IsExcluded": true,
        "Path": "/#/negotiate"
      },
      {
        "IsExcluded": true,
        "Path": "/error/*"
      },
      {
        "StatusCodes": [ 400, 500, 408 ]
      },
      {
        "Path": "/api/{id}/status",
        "Methods": [ "GET" ]
      }
    ]
  },
  "AllowedHosts": "*"
}
