<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>$(AppTargetFramework)</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>30b02175-f7c8-4965-a29b-6ac5d4f9bcf5</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Juice.Audit.Api\Juice.Audit.Api.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.AspNetCore\Juice.Audit.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.EF.PostgreSQL\Juice.Audit.EF.PostgreSQL.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.EF.SqlServer\Juice.Audit.EF.SqlServer.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.EF\Juice.Audit.EF.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.Messaging\Juice.Audit.Messaging.csproj" />
    </ItemGroup>

    <ItemGroup Label="Sample orders (AddAuditPipeline)">
        <PackageReference Include="Juice.MediatR.Behaviors" Version="$(JuiceVersion)" />
        <PackageReference Include="Juice.AspNetCore" Version="$(JuiceVersion)" />
        <PackageReference Include="Juice.Messaging.Outbox.EF" Version="$(JuiceMessagingVersion)" />
        <PackageReference Include="Juice.Messaging.Idempotency.Caching" Version="$(JuiceMessagingVersion)" />
        <PackageReference Include="Juice.EventBus.RabbitMQ" Version="$(JuiceMessagingVersion)" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFVersion)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Juice.Measurement.Stores.EF.PostgreSQL" Version="$(JuiceMeasurement)" />
        <PackageReference Include="Juice.Measurement.Stores.EF.SqlServer" Version="$(JuiceMeasurement)" />
    </ItemGroup>

    <ItemGroup Label="Migrations">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EFVersion)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EFVersion)">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.14.0" />
    </ItemGroup>
</Project>
