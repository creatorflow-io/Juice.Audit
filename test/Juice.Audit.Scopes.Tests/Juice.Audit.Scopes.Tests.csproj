<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AppTestTargetFramework)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdk)" />
        <PackageReference Include="xunit.v3" Version="$(XUnitVersion)" />
        <PackageReference Include="xunit.runner.visualstudio" Version="$(XUnitRunnerVersion)">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <PackageReference Include="FluentAssertions" Version="6.8.0" />
        <!-- Outbox tests: a SQLite business context under TransactionBehavior, delivered by the local transport. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFVersion)" />
        <PackageReference Include="Juice.MediatR.Behaviors" Version="$(JuiceVersion)" />
        <PackageReference Include="Juice.Messaging.Outbox.EF" Version="$(JuiceMessagingVersion)" />
        <PackageReference Include="Juice.Messaging.Local" Version="$(JuiceMessagingVersion)" />
        <!-- [InitializeMessageContext] for the messaging tests (constitution: quality gates). -->
        <PackageReference Include="Juice.XUnit" Version="$(JuiceVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Juice.Audit.Api\Juice.Audit.Api.csproj" />
        <ProjectReference Include="..\..\src\Juice.Audit.Messaging\Juice.Audit.Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
