<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AppTargetFramework)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Audits the data changed by integration event handlers (Juice.Messaging consumers) under the message's trace id, as UseAudit() does for a request.</Description>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Juice.Audit.Api\Juice.Audit.Api.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Juice.Audit.Scopes.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Juice.Messaging" Version="$(JuiceMessagingVersion)" />
        <!-- IConsumerBuilder (via Juice.EventBus) and the local transport for in-process mode. -->
        <PackageReference Include="Juice.Messaging.Local" Version="$(JuiceMessagingVersion)" />
        <!-- AddAuditPipeline in-process: the delivery processor of the app's outbox for the local publisher. -->
        <PackageReference Include="Juice.Messaging.Outbox.Delivery" Version="$(JuiceMessagingVersion)" />
    </ItemGroup>

</Project>
