<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(AppTargetFramework)</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Description>Audit abstraction and default services.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Juice" Version="$(JuiceVersion)" />
        <PackageReference Include="Juice.MediatR" Version="$(JuiceVersion)" />
        <Using Include="Juice.MediatR"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Juice.Audit.Api.Contracts\Juice.Audit.Api.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The gRPC mapper and the export metrics are shared with the audit packages, not public API. -->
        <InternalsVisibleTo Include="Juice.Audit.Api" />
        <InternalsVisibleTo Include="Juice.Audit.Messaging" />
        <InternalsVisibleTo Include="Juice.Audit.Scopes.Tests" />
        <InternalsVisibleTo Include="Juice.Audit.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Net.ClientFactory" Version="$(GrpcVersion)" />
        <!-- The background export worker (BackgroundService) and its options. -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    </ItemGroup>

</Project>
